<Window x:Class="Modeltreinbesturing.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Over Modeltreinbesturing" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Modeltreinbesturing" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="VersieTekst" Foreground="DimGray" Margin="0,0,0,16"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Een open-source programma om een modeltreinbaan digitaal te ontwerpen en automatisch te besturen, geïnspireerd op Koploper. Onafhankelijke implementatie, geen officiële band met Koploper of PaHaSOFT."/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Grotendeels ontwikkeld met behulp van Claude (Anthropic) als programmeerhulpmiddel."/>
        <TextBlock Text="Broncode, documentatie en de nieuwste versie:" Margin="0,0,0,4" FontWeight="Bold"/>
        <TextBox x:Name="RepositoryUrlBox" IsReadOnly="True" Margin="0,0,0,16" Padding="4"/>
        <Button Content="Sluiten" Padding="10,4" HorizontalAlignment="Left" Click="Sluiten_Click"/>
    </StackPanel>
</Window>
