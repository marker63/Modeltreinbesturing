<Window x:Class="Modeltreinbesturing.OudereBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oudere backup openen" Height="420" Width="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Er wordt automatisch een backup gemaakt bij het sluiten van het programma. Kies hieronder een eerdere versie om te openen - de huidige, nog niet-opgeslagen wijzigingen gaan dan verloren."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Openen" Padding="10,4" Margin="0,0,8,0" Click="Openen_Click" IsDefault="True"/>
            <Button Content="Annuleren" Padding="10,4" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="BackupsLijst"/>
    </DockPanel>
</Window>
