<Window x:Class="Modeltreinbesturing.BlokEigenschappenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eigenschappen blok" Height="600" Width="400" MinHeight="400" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuleren" Padding="10,4" Margin="0,0,8,0" Click="Annuleren_Click"/>
            <Button Content="OK" Padding="10,4" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Nummer:" Margin="0,0,0,4"/>
                <TextBox x:Name="NummerBox" Margin="0,0,0,16"/>

                <TextBlock Text="Omschrijving:" Margin="0,0,0,4"/>
                <TextBox x:Name="OmschrijvingBox" Margin="0,0,0,16"/>

                <TextBlock Text="Type:" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeCombo" Margin="0,0,0,16"/>

                <TextBlock Text="Max treinlengte (cm, 0 = onbeperkt):" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxTreinlengteBox" Margin="0,0,0,16"/>

                <TextBlock Text="Max snelheid op dit traject (km/u, 0 = geen eigen limiet):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox x:Name="MaxSnelheidBox" Margin="0,0,0,16"/>

                <TextBlock Text="Uitroltijd bij stoppen (sec, -1 = gebruik de standaardwaarde):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox x:Name="UitrolSecondenBox" Margin="0,0,0,16"/>

                <TextBlock Text="Werkelijke bloklengte (cm, 0 = onbekend/niet meegeteld voor de afgelegde-afstand-teller):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox x:Name="LengteCmBox" Margin="0,0,0,16"/>

                <CheckBox x:Name="VergrendeldBox" Content="Tijdelijk vergrendeld (buiten gebruik, geen storing)" Margin="0,0,0,4"
                          ToolTip="Geen enkele automatische rit stuurt hier nog een trein naartoe zolang dit aangevinkt staat - handig als je bijv. rails aan het schoonmaken/repareren bent. Telt NIET als een storing (Foutmelding) in de onderhoudslog/spookmelding-logica."/>
                <TextBlock Text="Reden (optioneel):" Margin="0,0,0,4"/>
                <TextBox x:Name="VergrendelRedenBox" Margin="0,0,0,16"/>

                <TextBlock Text="Actie bij te lange trein (aan te vinken, onafhankelijk van elkaar):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <CheckBox x:Name="MagNietStoppenBox" Content="Mag niet stoppen" Margin="0,0,0,2"/>
                <CheckBox x:Name="VorigBlokLangerBezetBox" Content="Vorig blok langer bezet houden" Margin="0,0,0,2"/>
                <CheckBox x:Name="WisselstraatLangerBezetBox" Content="Wisselstraat langer bezet houden" Margin="0,0,0,16"/>

                <TextBlock Text="Bezetmeldpunten:" Margin="0,0,0,4" FontWeight="Bold"/>
                <ListBox x:Name="MeldpuntenLijst" Height="140" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Meldernummer:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="MeldernummerBox" Width="60" Margin="0,0,10,0"/>
                    <ComboBox x:Name="RolCombo" Width="110"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Max. treinlengte (cm):" VerticalAlignment="Center" Margin="0,0,6,0" TextWrapping="Wrap" Width="120"/>
                    <TextBox x:Name="MaxTreinlengteMelderBox" Width="60"/>
                    <TextBlock Text="(alleen bij Stopsectie; 0 = geen limiet, meerdere stopsecties = 'dynamische lengte')" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="DimGray" FontSize="10" TextWrapping="Wrap" Width="180"/>
                </StackPanel>
                <CheckBox x:Name="MagVorigBlokVrijgevenBox" Content="Mag vorig blok vrijgeven" Margin="0,0,0,8" IsChecked="True"
                          ToolTip="Koploper: 'bij de stopmelder heb ik opgegeven dat het vorige blok vrijgegeven mag worden' - uitzetten laat het blok dat de trein hiervoor verliet bewust bezet staan (bijv. voor een schaduwstation waar je de vrijgave later, expliciet, wilt laten gebeuren)."/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Toevoegen" Padding="8,4" Margin="0,0,8,0" Click="Toevoegen_Click"/>
                    <Button Content="Verwijderen" Padding="8,4" Click="Verwijderen_Click"/>
                </StackPanel>

                <TextBlock Text="Richtingsafhankelijke bezetmeldingen (optioneel):" Margin="0,0,0,4" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Foreground="DimGray" FontSize="10"
                           Text="Per aankomstrichting ('uit blok') een eigen reeks meldernummers - overschrijft de generieke Bezetmeldpunten hierboven, maar ALLEEN voor die specifieke richting. Onvermeld = deze richting valt terug op de generieke meldpunten hierboven. BELANGRIJK: de volgorde hier moet de ECHTE, FYSIEKE volgorde zijn waarin de sensoren afgaan tijdens het binnenrijden vanuit die richting (eerste = meteen bij binnenkomst, laatste = pas bij het echte eindpunt/stootblok) - dit is hoe DEZE software 'aankomst bevestigd' en 'veilig om te keren' uit elkaar houdt. Twijfel je over de juiste volgorde? Laat dit veld leeg en laat de software het zelf leren tijdens het rijden (zie Beheren -> Geleerde reistijden bekijken) - dat gebeurt automatisch op basis van wat er echt gemeten wordt, dus nooit verkeerd om."/>
                <ListBox x:Name="RichtingsMeldingenLijst" Height="100" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Uit blok:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="VanBlokCombo" Width="90"/>
                </StackPanel>
                <TextBlock Text="Meldernummers op volgorde (spatie-gescheiden, bijv. '1 9 10'):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBox x:Name="MeldernummersVolgordeBox" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Toevoegen/bijwerken" Padding="8,4" Margin="0,0,8,0" Click="RichtingsMeldingToevoegen_Click"/>
                    <Button Content="Verwijderen" Padding="8,4" Click="RichtingsMeldingVerwijderen_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
