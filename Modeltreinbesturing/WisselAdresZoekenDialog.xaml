<Window x:Class="Modeltreinbesturing.WisselAdresZoekenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wisseladres zoeken" Height="460" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Doorloopt een reeks wisseladressen: zet voor elk adres om de beurt afbuigend en rechtdoor, met een pauze ertussen. Kijk of luister welke fysieke wissel daarbij beweegt, en noteer bij welk adres dat gebeurde - er is geen automatische terugmelding voor wisselstanden, dus dit blijft net als bij Koploper zelf uitkijken/luisteren."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Van adres:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="VanAdresBox" Width="60" Text="1"/>
            <TextBlock Text="Tot en met adres:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="TotAdresBox" Width="60" Text="30"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Pauze per adres (sec):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PauzeBox" Width="60" Text="4"/>
        </StackPanel>

        <TextBlock x:Name="StatusTekst" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="Bold" Foreground="DarkSlateGray" Margin="0,4,0,8" Text="Nog niet gestart."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="StartKnop" Content="Start" Padding="10,4" Margin="0,0,8,0" Click="Start_Click"/>
            <Button x:Name="StopKnop" Content="Stop" Padding="10,4" Margin="0,0,8,0" Click="Stop_Click" IsEnabled="False"/>
            <Button Content="Sluiten" Padding="10,4" Click="Sluiten_Click"/>
        </StackPanel>

        <ListBox x:Name="LogLijst" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12"/>
    </DockPanel>
</Window>
