<Window x:Class="Modeltreinbesturing.TreintypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onderhouden treintypes" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Wijzigingen opslaan" Padding="8,4" Margin="0,0,8,0" Click="Opslaan_Click"/>
            <Button Content="Nieuw treintype" Padding="8,4" Margin="0,0,8,0" Click="Nieuw_Click"/>
            <Button Content="Verwijderen" Padding="8,4" Margin="0,0,8,0" Click="Verwijderen_Click"/>
            <Button Content="Sluiten" Padding="8,4" Click="Sluiten_Click"/>
        </StackPanel>
        <!-- Database-brede instelling (geldt niet voor één specifiek treintype, dus bewust
             BUITEN de tabbladen/lijst gehouden) - Koploper's "Algemeen -> Instellingen per
             database": welk treintype als rangeertreintype fungeert. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Rangeertreintype (database-breed):" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" Width="220"
                       ToolTip="Als een gebruiker 'Rangeer' aanzet op een loc, gebruikt de simulatie voor die rit de snelheden van DIT treintype in plaats van de eigen route/treintype-snelheid - net als het echte Koploper."/>
            <ComboBox x:Name="RangeerTreintypeCombo" Width="180" Margin="0,0,8,0"/>
            <Button Content="Zet" Padding="8,4" Click="RangeerTreintypeZetten_Click"/>
        </StackPanel>
        <ListBox x:Name="TreintypesLijst" DockPanel.Dock="Left" Width="200" Margin="0,0,8,0"
                 SelectionChanged="TreintypesLijst_SelectionChanged"/>

        <TabControl x:Name="Tabbladen">
            <TabItem Header="Stamgegevens">
                <StackPanel Margin="12">
                    <TextBlock Text="Omschrijving:" Margin="0,0,0,4"/>
                    <TextBox x:Name="OmschrijvingBox" Margin="0,0,0,16"/>

                    <TextBlock Text="Snelheden (km/u)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Maximum:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxSnelheidBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Gemiddelde:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="GemiddeldeSnelheidBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Minimum:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="MinimumSnelheidBox" Width="80"/>
                    </StackPanel>

                    <TextBlock Text="Massa simulatie (seconden)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Van 0 naar 50 in:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="AccelaratieBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Van 50 naar 0 in:" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="RemBox" Width="80"/>
                    </StackPanel>

                    <TextBlock Text="Divers" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Wachttijd bij keren:" Width="140" VerticalAlignment="Center"/>
                        <TextBox x:Name="WachttijdKerenBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Vertrekvertraging na veilig sein:" Width="140" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="VertrekvertragingBox" Width="80"/>
                    </StackPanel>
                    <TextBlock Text="Stopkans op een gewoon blok (bijv. voor goederentreinen):" Margin="0,10,0,4" TextWrapping="Wrap" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Stopkans (%, 0 = nooit):" Width="140" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="StopkansBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Min./max. wachttijd bij stop:" Width="140" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBox x:Name="MinWachttijdStopBox" Width="35" Margin="0,0,4,0"/>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="MaxWachttijdStopBox" Width="35"/>
                        <TextBlock Text="sec" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Treintype per bloktype">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Hoe dit treintype zich per bloktype gedraagt: de kans dat er (extra) gestopt wordt, en hoe lang. Zet de stopkans op 0% om dit treintype een bloktype (bijv. een station) altijd te laten voorbijrijden zonder te stoppen. Station staat standaard op 100% (altijd stoppen) - de andere bloktypes standaard op 0%."/>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bloktype" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Stopkans %" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Min sec" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Max sec" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Normaal" Margin="0,4,0,0"/>
                        <TextBox x:Name="NormaalStopkansBox" Grid.Row="1" Grid.Column="1" Margin="0,4,4,0"/>
                        <TextBox x:Name="NormaalMinBox" Grid.Row="1" Grid.Column="2" Margin="0,4,4,0"/>
                        <TextBox x:Name="NormaalMaxBox" Grid.Row="1" Grid.Column="3" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Station" Margin="0,4,0,0"/>
                        <TextBox x:Name="StationStopkansBox" Grid.Row="2" Grid.Column="1" Margin="0,4,4,0"/>
                        <TextBox x:Name="StationMinBox" Grid.Row="2" Grid.Column="2" Margin="0,4,4,0"/>
                        <TextBox x:Name="StationMaxBox" Grid.Row="2" Grid.Column="3" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Kopspoor" Margin="0,4,0,0"/>
                        <TextBox x:Name="KopspoorStopkansBox" Grid.Row="3" Grid.Column="1" Margin="0,4,4,0"/>
                        <TextBox x:Name="KopspoorMinBox" Grid.Row="3" Grid.Column="2" Margin="0,4,4,0"/>
                        <TextBox x:Name="KopspoorMaxBox" Grid.Row="3" Grid.Column="3" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Opstelspoor" Margin="0,4,0,0"/>
                        <TextBox x:Name="OpstelspoorStopkansBox" Grid.Row="4" Grid.Column="1" Margin="0,4,4,0"/>
                        <TextBox x:Name="OpstelspoorMinBox" Grid.Row="4" Grid.Column="2" Margin="0,4,4,0"/>
                        <TextBox x:Name="OpstelspoorMaxBox" Grid.Row="4" Grid.Column="3" Margin="0,4,0,0"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11" Foreground="DimGray"
                               Text="Wijzigingen hier worden pas bewaard als je 'Wijzigingen opslaan' onderaan klikt, net als bij de andere tabbladen."/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Treinroutes">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Welke variabele treinroutes gelden voor dit treintype. Dubbelklik een route om 'm te koppelen/loskoppelen."/>
                    <ListBox x:Name="TreinroutesLijst" MouseDoubleClick="TreinroutesLijst_MouseDoubleClick"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Waar">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Treinen die aan dit treintype gekoppeld zijn (in te stellen bij Treinen beheren)."/>
                    <ListBox x:Name="GekoppeldeTreinenLijst"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
