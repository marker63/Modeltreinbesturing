<Window x:Class="Modeltreinbesturing.TreinrouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modeltreinbesturing - Treinroutes" Height="750" Width="1400" MinHeight="500" MinWidth="1100"
        KeyDown="Window_KeyDown" Closed="Window_Closed">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Programma">
                <MenuItem Header="Programma afsluiten" Click="ProgrammaAfsluiten_Click"/>
            </MenuItem>
        </Menu>
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="6" Background="#EEE">
                <!-- Het rode/groene "spiegelei" uit Koploper's eigen werkbalk: schakelt de
                     spanning/centrale eenheid aan/uit. Wordt automatisch onbruikbaar (grijs)
                     zodra er een trein rijdt - je kunt de spanning pas weer uitzetten als
                     alles stilstaat, precies zoals in het echte Koploper. -->
                <Button x:Name="SpanningKnop" Width="32" Height="32" Margin="4" Padding="0" ToolTip="Spanning aan/uit (centrale eenheid)" Click="Spanning_Click">
                    <Ellipse x:Name="SpanningEllipse" Width="22" Height="22" Fill="ForestGreen" Stroke="Black" StrokeThickness="1"/>
                </Button>
                <Separator Margin="4,0"/>
                <!-- Snelle klok (eigen functie, geen Koploper-begrip): een tijdklok die
                     sneller loopt dan echt, met een optionele geplande vertrektijd per
                     route (zie Route-eigenschappen hieronder) voor een tijdklok-gestuurde
                     dienstregeling. -->
                <TextBlock Text="🕐" FontSize="18" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBlock x:Name="KlokTekst" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Width="50"/>
                <CheckBox x:Name="KlokActiefBox" Content="Klok loopt" VerticalAlignment="Center" Margin="0,0,8,0" Checked="KlokActiefToggle_Changed" Unchecked="KlokActiefToggle_Changed"/>
                <TextBlock Text="sec/modelmin:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                <TextBox x:Name="KlokSnelheidBox" Width="35" Margin="0,0,4,0"/>
                <Button Content="Zet" Padding="6,2" Margin="0,0,8,0" Click="KlokSnelheidZetten_Click" ToolTip="Hoeveel echte seconden er verstrijken per gesimuleerde modelminuut - lager is sneller."/>
                <Button Content="Spoorboekje..." Padding="6,2" Margin="0,0,8,0" Click="SpoorboekjeExporteren_Click"
                        ToolTip="Exporteert alle routes met een geplande vertrektijd, op tijd gesorteerd, als een leesbaar tekstbestand - net als een echt dienstregelingsboekje."/>
                <Separator Margin="4,0"/>
                <Button Content="Nieuwe route" Padding="8,4" Margin="4" Click="NieuweRoute_Click"/>
                <Button Content="Dupliceer route" Padding="8,4" Margin="4" Click="DupliceerRoute_Click"/>
                <Button Content="Exporteer als afbeelding" Padding="8,4" Margin="4" Click="Exporteren_Click"/>
                <Button Content="Klaar (stop hier)" Padding="8,4" Margin="4" Click="Klaar_Click"/>
                <Separator Margin="8,0"/>
                <Button Content="Start rijden" Padding="8,4" Margin="4" Click="StartRijden_Click"/>
                <Button Content="Opstellen" Padding="8,4" Margin="4" Click="Opstellen_Click"/>
                <Button Content="Vrijgeven" Padding="8,4" Margin="4" Click="Vrijgeven_Click"/>
                <Button Content="Stop rijden" Padding="8,4" Margin="4" Click="StopRijden_Click"/>
                <Button Content="NOODSTOP (alles stoppen)" Padding="8,4" Margin="4" Background="Firebrick" Foreground="White" FontWeight="Bold" Click="Noodstop_Click"/>
                <Button Content="In wachtrij zetten" Padding="8,4" Margin="4" Click="InWachtrijZetten_Click"/>
                <Button Content="Sluiten" Padding="8,4" Margin="16,4,4,4" Click="Sluiten_Click"/>
                <Button Content="Help (F1)" Padding="8,4" Margin="4" Click="Gebruiksaanwijzing_Click"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusTekst" DockPanel.Dock="Top" Margin="6,0,6,6" Foreground="DarkSlateGray" TextWrapping="Wrap"
                   Text="Klik 'Nieuwe route' om te beginnen."/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="6,0,6,6">
            <TextBlock Text="Dagdeel:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
            <TextBlock x:Name="DagdeelTekst" Text="AM" VerticalAlignment="Center" Width="30" FontWeight="Bold" Foreground="DarkGoldenrod"/>
            <Button Content="Wissel AM/PM" Padding="6,2" Click="WisselDagdeel_Click"/>
        </StackPanel>

        <!-- Alle zijpanelen staan nu in een Grid met sleepbare GridSplitters in plaats van
             vaste breedtes - met 4 vaste kolommen (route-lijst/geldigheid x2/log) bleef er
             nauwelijks ruimte over voor het schema zelf, juist het belangrijkste onderdeel
             tijdens het rijden. Nu krijgt het schema (kolom met "*") standaard alle
             overgebleven ruimte, en kan de gebruiker elke scheidingslijn zelf verslepen om
             een zijpaneel groter/kleiner te maken naar wens. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="RoutesLijst" Grid.Column="0" Margin="6" SelectionChanged="RoutesLijst_SelectionChanged"/>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>

            <ScrollViewer Grid.Column="2" Margin="0,6,0,6" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Geldt voor treintype:" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="TreintypeCombo" Width="140" Margin="0,0,4,0"/>
                        <Button Content="Zet" Padding="6,2" Click="ZetTreintype_Click"/>
                    </StackPanel>
                    <TextBlock Text="Max. snelheid voor deze route (km/u, 0 = geen eigen limiet):" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="RouteMaxSnelheidBox" Width="60" Margin="0,0,4,0"/>
                        <Button Content="Zet" Padding="6,2" Click="ZetRouteMaxSnelheid_Click"/>
                    </StackPanel>
                    <TextBlock Text="Trein om mee te rijden:" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox x:Name="TreinCombo" Width="190" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <CheckBox x:Name="BlijfWachtenBox" Content="Blijf wachten in bestemming" Margin="0,0,0,4" Checked="BlijfWachtenBox_Changed" Unchecked="BlijfWachtenBox_Changed"/>
                    <CheckBox x:Name="HogePrioriteitBox" Content="Hoge prioriteit" Margin="0,0,0,4" Checked="HogePrioriteitBox_Changed" Unchecked="HogePrioriteitBox_Changed"/>
                    <TextBlock Text="Mag rijden in dagdeel:" FontWeight="Bold" Margin="0,4,0,2" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="DagdeelBeideBox" Content="Beide" GroupName="Dagdeel" Margin="0,0,8,0" Checked="Dagdeel_Changed"/>
                        <RadioButton x:Name="DagdeelOchtendBox" Content="AM" GroupName="Dagdeel" Margin="0,0,8,0" Checked="Dagdeel_Changed"/>
                        <RadioButton x:Name="DagdeelMiddagBox" Content="PM" GroupName="Dagdeel" Checked="Dagdeel_Changed"/>
                    </StackPanel>
                    <TextBlock Text="Geplande vertrektijd (dienstregeling, leeg = geen):" FontWeight="Bold" Margin="0,4,0,2" TextWrapping="Wrap"
                               ToolTip="Zodra de snelle klok (bovenin) dit tijdstip bereikt, probeert het programma deze route automatisch te starten met de trein die op dat moment op het startblok staat."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="GeplandeVertrektijdBox" Width="60" Margin="0,0,4,0"/>
                        <TextBlock Text="(uu:mm)" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="DimGray"/>
                        <Button Content="Zet" Padding="6,2" Click="GeplandeVertrektijdZetten_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="HerhalenBox" Content="Herhalen (pendeldienst)" Margin="0,0,0,4" Checked="HerhalenBox_Changed" Unchecked="HerhalenBox_Changed"/>
                    <CheckBox x:Name="AutomatischBox" Margin="0,0,0,8" Checked="AutomatischBox_Changed" Unchecked="AutomatischBox_Changed">
                        <TextBlock Text="Automatisch rijden (kiest zelf 1e vrije/toegestane blok)" TextWrapping="Wrap" Width="170"/>
                    </CheckBox>
                    <TextBlock Text="Bestemmingsblok (optioneel):" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="BestemmingsblokCombo" Width="140" Margin="0,0,4,0"/>
                        <Button Content="Zet" Padding="6,2" Click="ZetBestemmingsblok_Click"/>
                    </StackPanel>
                    <TextBlock Text="Info (notitie):" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox x:Name="InfoBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" LostFocus="InfoBox_LostFocus"/>
                    <TextBlock Text="Wachtrij" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="WachtrijLijst" Height="80" Margin="0,0,0,8"/>
                    <TextBlock Text="Actieve treinen (rijwindow)" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="ActieveTreinenLijst" Height="120"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Stop" Padding="8,2" Margin="0,0,4,0" Background="Firebrick" Foreground="White" Click="StopGeselecteerdeTrein_Click"/>
                        <Button Content="Go" Padding="8,2" Margin="0,0,4,0" Background="ForestGreen" Foreground="White" Click="GaGeselecteerdeTrein_Click"/>
                        <Button Content="Laatste blokken" Padding="8,2" Click="LaatsteBlokkenTonen_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>

            <ScrollViewer Grid.Column="4" Margin="0,6,0,6" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Geldt voor:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Margin="0,0,0,4">
                        <RadioButton x:Name="GeldigheidAlleBox" Content="Alle" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed"/>
                        <RadioButton x:Name="GeldigheidTreintypeBox" Content="Treintype" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed"/>
                        <RadioButton x:Name="GeldigheidTreintypeEnRijwindowBox" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed">
                            <TextBlock Text="Treintype/Rijwindow" TextWrapping="Wrap" Width="160"/>
                        </RadioButton>
                        <RadioButton x:Name="GeldigheidRijwindowBox" Content="Rijwindow" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed"/>
                        <RadioButton x:Name="GeldigheidTreinstelBox" Content="Treinstel" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed"/>
                        <RadioButton x:Name="GeldigheidLocomotiefBox" Content="Locomotief" GroupName="Geldigheid" Margin="0,0,0,2" Checked="Geldigheid_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="GeldigeTreintypesLabel" Text="Welke treintypes:" FontWeight="Bold" Margin="0,4,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="GeldigeTreintypesLijst" Height="90" Margin="0,0,0,4" SelectionMode="Extended" SelectionChanged="GeldigeTreintypesLijst_SelectionChanged"/>
                    <TextBlock x:Name="GeldigeTreinenLabel" Text="Welke treinen:" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="GeldigeTreinenLijst" Height="90" Margin="0,0,0,4" SelectionMode="Extended" SelectionChanged="GeldigeTreinenLijst_SelectionChanged"/>
                    <TextBlock Text="Uitgesloten wissels:" FontWeight="Bold" Margin="0,4,0,4" TextWrapping="Wrap"/>
                    <ListBox x:Name="UitgeslotenWisselsLijst" SelectionMode="Extended" Height="80" SelectionChanged="UitgeslotenWisselsLijst_SelectionChanged"/>
                    <TextBlock Text="Alternatieve startblokken:" FontWeight="Bold" Margin="0,4,0,4" TextWrapping="Wrap"
                               ToolTip="Koploper: 'soms is het handig als een vaste treinroute vanuit meerdere richtingsblokken gestart kan worden' - staat de gekozen trein bij het starten op een van deze blokken i.p.v. op het Startblok zelf, dan wordt de route gewoon vanaf DAT blok gereden (de rest van het pad blijft hetzelfde)."/>
                    <ListBox x:Name="AlternatieveStartblokkenLijst" SelectionMode="Extended" Height="80" SelectionChanged="AlternatieveStartblokkenLijst_SelectionChanged"/>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="5" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>

            <ScrollViewer Grid.Column="6" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="SchemaCanvas" Background="White" Width="3000" Height="3000" MouseLeftButtonDown="SchemaCanvas_MouseLeftButtonDown"/>
            </ScrollViewer>
            <GridSplitter Grid.Column="7" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>

            <DockPanel Grid.Column="8" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="Bold" Margin="0,0,0,4"/>
                <Button DockPanel.Dock="Bottom" Content="Kopieer log naar klembord" Padding="8,4" Margin="0,4,0,0" Click="KopieerLog_Click"/>
                <ListBox x:Name="LogLijst" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
