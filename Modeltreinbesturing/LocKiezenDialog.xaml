<Window x:Class="Modeltreinbesturing.LocKiezenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loc plaatsen" Height="160" Width="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="OmschrijvingTekst" Text="Welke trein plaats je hier?" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <ComboBox x:Name="TreinCombo" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" Padding="10,4" Margin="0,0,8,0" Click="Annuleren_Click"/>
            <Button Content="Plaatsen" Padding="10,4" IsDefault="True" Click="Plaatsen_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
