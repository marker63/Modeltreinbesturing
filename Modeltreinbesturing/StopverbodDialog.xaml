<Window x:Class="Modeltreinbesturing.StopverbodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stopverboden beheren" Height="440" Width="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Blokken waar een trein niet mag stoppen. Een route die zo'n blok in het pad heeft, kan niet gereden worden. Kies optioneel een treintype om het verbod alleen daarvoor te laten gelden - zonder keuze geldt het voor alle treintypes."/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="BlokCombo" Width="120" Margin="0,0,8,0"/>
                <ComboBox x:Name="TreintypeCombo" Width="140" Margin="0,0,4,0"/>
                <Button Content="✕" Padding="6,4" Margin="0,0,8,0" Click="TreintypeWissen_Click" ToolTip="Treintype-keuze wissen (verbod geldt dan voor alle treintypes)"/>
                <Button Content="Toevoegen" Padding="8,4" Click="Toevoegen_Click"/>
            </StackPanel>
            <TextBlock Text="(geen treintype gekozen = geldt voor alle treintypes)" FontSize="11" Foreground="DimGray" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Verwijderen" Padding="8,4" Margin="0,0,8,0" Click="Verwijderen_Click"/>
                <Button Content="Sluiten" Padding="8,4" Click="Sluiten_Click"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="VerbodenLijst"/>
    </DockPanel>
</Window>
