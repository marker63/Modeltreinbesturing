<Window x:Class="Modeltreinbesturing.BlokgroepenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blokgroepen beheren" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Een blokgroep bundelt onderling gelijkwaardige blokken (bijv. parallelle opstelsporen in een schaduwstation). Bij 'Enkele treinbeweging' mag er maar in één blok van de hele groep tegelijk een trein actief zijn."/>
        <Button DockPanel.Dock="Bottom" Content="Sluiten" Padding="10,4" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Sluiten_Click"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Groepen" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Nieuwe groep" Padding="6,2" Margin="0,0,4,0" Click="NieuweGroep_Click"/>
                    <Button Content="Verwijderen" Padding="6,2" Click="VerwijderGroep_Click"/>
                </StackPanel>
                <ListBox x:Name="GroepenLijst" SelectionChanged="GroepenLijst_SelectionChanged"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Naam:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="NaamBox" Width="160" Margin="0,0,8,0" LostFocus="NaamBox_LostFocus"/>
                </StackPanel>
                <CheckBox x:Name="EnkeleTreinbewegingBox" DockPanel.Dock="Top" Content="Enkele treinbeweging (max. 1 trein tegelijk in de hele groep)" Margin="0,0,0,4" Checked="Opties_Changed" Unchecked="Opties_Changed"/>
                <CheckBox x:Name="GecombineerdeStopmelderBox" DockPanel.Dock="Top" Content="Gecombineerde stopmelder" Margin="0,0,0,8" Checked="Opties_Changed" Unchecked="Opties_Changed"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox x:Name="BlokCombo" Width="140" Margin="0,0,4,0"/>
                    <Button Content="Toevoegen" Padding="6,2" Margin="0,0,4,0" Click="BlokToevoegen_Click"/>
                    <Button Content="Verwijderen" Padding="6,2" Click="BlokVerwijderen_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Blokken in deze groep:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="BlokkenLijst"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
