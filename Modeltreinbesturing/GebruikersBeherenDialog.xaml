<Window x:Class="Modeltreinbesturing.GebruikersBeherenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gebruikers beheren" Height="380" Width="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Accounts met toegang tot de bouwschermen. Een beheerder kan ook zelf weer andere accounts toevoegen/verwijderen; een gewone gebruiker niet."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Nieuw account..." Padding="8,4" Margin="0,0,8,0" Click="NieuwAccount_Click"/>
            <Button Content="Verwijderen" Padding="8,4" Margin="0,0,8,0" Click="Verwijderen_Click"/>
            <Button Content="Sluiten" Padding="8,4" Click="Sluiten_Click"/>
        </StackPanel>
        <ListBox x:Name="GebruikersLijst"/>
    </DockPanel>
</Window>
