<Window x:Class="Modeltreinbesturing.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modeltreinbesturing - Gebruiksaanwijzing" Height="750" Width="820"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4">
            <TextBlock Text="Zoeken:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ZoekBox" Width="260" TextChanged="ZoekBox_TextChanged"/>
            <TextBlock x:Name="ZoekResultaatTekst" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="OnderwerpenLijst" Grid.Column="0" Margin="10,0,4,10" SelectionChanged="OnderwerpenLijst_SelectionChanged"/>
            <FlowDocumentScrollViewer x:Name="InhoudViewer" Grid.Column="1" Margin="4,0,10,10" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
