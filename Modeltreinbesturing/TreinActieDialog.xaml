<Window x:Class="Modeltreinbesturing.TreinActieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trein-acties" Height="300" Width="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="OmschrijvingTekst" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusTekst" Margin="0,0,0,16" TextWrapping="Wrap" Foreground="DimGray"/>
        <Button x:Name="PauzeerKnop" Content="⏸ Pauzeer deze trein" Padding="10,6" Margin="0,0,0,8"/>
        <Button x:Name="HervatKnop" Content="▶ Hervat (uit pauze)" Padding="10,6" Margin="0,0,0,8"/>
        <Button x:Name="KeerKnop" Content="↺ Keer rijrichting (direct)" Padding="10,6" Margin="0,0,0,8"/>
        <Button x:Name="ReserveringOpheffenKnop" Content="✕ Reservering opheffen" Padding="10,6" Margin="0,0,0,8"/>
        <Button x:Name="VerwijderKnop" Content="🚫 Loc uit blok halen (defect)" Padding="10,6" Margin="0,0,0,16"/>
        <Button Content="Sluiten" Padding="10,4" HorizontalAlignment="Right" Click="Sluiten_Click"/>
    </StackPanel>
</Window>
