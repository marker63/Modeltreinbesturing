<mxfile><diagram id="p0" name="1 Hoofdflow"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0_s" value="START verkenning (Stap voor stap)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p0_a" value="A. Kennis laden (ZaaiKennis): vastgestelde blokken, kruismelder, rijrichtingen, wissel-onder-loc uit baankaart. Wat vaststaat wordt NOOIT overschreven (overschrijving = melding BUG #181)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_b" value="B. Wissels initialiseren: alle wissels naar bekende basisstand sturen (alle adressen), kruismotoren 10/13 volgens instelling Engelse wissel; wacht op terugmelding Dinamo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_c" value="C. Loc zoeken (zie pagina 2)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="p0_d" value="D. Blok van de startmelder vinden (blokproef, pagina 3)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p0_e" value="E. Kies volgende opdracht (KiesVolgendeOpdracht): score = afstand*1000 + pogingen*100000 + index; blokproef krijgt +50.000.000 (komt laatst)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_f" value="Is er een opdracht?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="250" height="100" as="geometry"/></mxCell><mxCell id="p0_g" value="F. Naar startpositie (NaarStartVan): route over bekende melders, wissels pas zetten als de loc de melder met die wissels verlaten heeft (pagina 4)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_h" value="G. Opdracht uitvoeren: rit (pagina 4), registreer overgang A→B met rijrichting, wisselstand als bewijs" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="1080" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_i" value="H. Nieuwe melder? Blokproef op nieuwe sectie (pagina 3), tweede-bezoek-regel blijft tot robuust" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="930" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0_j" value="I. Kruiswissel-detectie: ≥4 buren of motorbewijs (pagina 6)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="780" width="230" height="70" as="geometry"/></mxCell><mxCell id="p0_k" value="J. Kortsluiting of afwijking onderweg? Herstel (pagina 5)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p0_l" value="Alle opdrachten klaar? Wisseltest en kruisproeven (pagina 6)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="230" height="70" as="geometry"/></mxCell><mxCell id="p0_z" value="EINDE: rapport (txt/html), baankaart, kennisregister, overschrijvingen-lijst" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="230" height="50" as="geometry"/></mxCell><mxCell id="p0_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_s" target="p0_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_a" target="p0_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_b" target="p0_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_c" target="p0_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_d" target="p0_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_e" target="p0_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl7" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_f" target="p0_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl8" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_f" target="p0_l"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_g" target="p0_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_h" target="p0_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_i" target="p0_j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_j" target="p0_k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl13" value="klaar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p0_k" target="p0_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0_pijl14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p0_l" target="p0_z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 Initialisatie en loc zoeken"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_s" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p1_a" value="Dinamo verbinden: COM10, 19200, odd parity. Terugmelding ontvangen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="100" as="geometry"/></mxCell><mxCell id="p1_a2" value="Geen terugmelding binnen tijd: 'Dinamo reageert niet' → herstart/Dinamo-uitval-herstel, bevindingen sinds eerste ontbrekende terugmelding ongeldig. Niet bij doodlopende ritten (BUG: valse melding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="230" height="100" as="geometry"/></mxCell><mxCell id="p1_b" value="Alle wissel-adressen sturen naar basisstand (rechtdoor); terugmeldingen vastleggen als _wisselStand. Geen loc in beweging tijdens het zetten." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1_c" value="Hoortest nodig? (gebruiker hoort wissel omgaan). Mislukt → Dinamo herstarten" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="250" height="100" as="geometry"/></mxCell><mxCell id="p1_d" value="Stand van meldingen lezen: welke melders zijn bezet?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p1_e" value="Eén melder bezet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="250" height="100" as="geometry"/></mxCell><mxCell id="p1_f" value="Alle blokken spanning (snelheid, kruip) in de rijrichting; kijk welke melder actief wordt (blok 1..N om beurten, ~30 s per blok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="230" height="90" as="geometry"/></mxCell><mxCell id="p1_g" value="Meerdere melders bezet: loc staat op grens. Doorrijden tot één melder bezet (Nastellen), niet omzetten van wissels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="780" width="230" height="90" as="geometry"/></mxCell><mxCell id="p1_h" value="Geen enkele melder wordt actief: andere richting; daarna FOUT 'Geen enkel Dinamo-blok kon de loc laten rijden' (controleer locadres, rijstappen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="930" width="230" height="90" as="geometry"/></mxCell><mxCell id="p1_i" value="Startmelder bekend. Loc volledig in sectie? Zo niet: rij door tot loc geheel in de sectie staat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1_z" value="Verder met pagina 3 (blokproef startsectie)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="230" height="50" as="geometry"/></mxCell><mxCell id="p1_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_s" target="p1_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl2" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_a" target="p1_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl3" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_a" target="p1_a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_b" target="p1_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl5" value="ok" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_c" target="p1_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_d" target="p1_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl7" value="nee/geen" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_e" target="p1_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl8" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_e" target="p1_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl9" value="herhaal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p1_g" target="p1_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl10" value="geen" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_f" target="p1_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl11" value="melder actief" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_f" target="p1_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_i" target="p1_z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_pijl13" value="meer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p1_e" target="p1_g"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 Blokproef (melder naar blok)"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_s" value="START blokproef voor sectie M" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p2_a" value="Loc geheel op alleen melder M zetten (Neerzetten): stop alle blokken, dan kruipen tot alleen M bezet. Lukt het niet → blokproef overgeslagen, rit gaat door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="100" as="geometry"/></mxCell><mxCell id="p2_b" value="Voor ieder onbekend blok B (volgorde: laatst gebruikt eerst): rijcommando vooruit, kleine snelheid, langere tijd (~30 s). Beweegt de loc (nieuwe melder actief)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="p2_c" value="Loc bewoog?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="250" height="100" as="geometry"/></mxCell><mxCell id="p2_d" value="VONDST: melder M krijgt rijstroom van blok B → KoppelBlok (Leg 'blok' in register, nooit overschrijven)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2_e" value="Volgend blok B+1 (tot alle blokken geprobeerd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="p2_f" value="Geen blok vooruit: 'misschien aan eind kopspoor' → andere richting (achteruit), alle blokken opnieuw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="230" height="90" as="geometry"/></mxCell><mxCell id="p2_g" value="Nog steeds geen blok: kopHierBekend? Vertrok loc niet terwijl blok bekend en kort geleden kortsluiting → melding, geen blok wissen. Anders: blok onbekend, stuur voortaan naar alle blokken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="780" width="230" height="110" as="geometry"/></mxCell><mxCell id="p2_h" value="Terugrijden naar startsectie: alle blokken rijcommando; terug in startmelder → weer vooruit tot geheel in nieuwe sectie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="90" as="geometry"/></mxCell><mxCell id="p2_z" value="Blok vastgelegd; verder met kies volgende opdracht" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="230" height="50" as="geometry"/></mxCell><mxCell id="p2_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_s" target="p2_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_a" target="p2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_b" target="p2_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl4" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_c" target="p2_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl5" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_c" target="p2_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl6" value="herhaal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2_e" target="p2_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl7" value="alles geprobeerd" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_e" target="p2_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl8" value="ook niets" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_f" target="p2_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_d" target="p2_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_h" target="p2_z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_pijl11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p2_g" target="p2_z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 Rit uitvoeren en wissels veilig zetten"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_s" value="START rit van melder A, richting R, doel (navigatie of verkenning)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p3_a" value="Staat de loc op startmelder? Anders: op verwacht pad verder, of doel al bereikt, of NavigatieFout (loc terugzetten)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="100" as="geometry"/></mxCell><mxCell id="p3_b" value="Alarmcontrole VOOR de stap: Dinamo-kortsluiting? Zo ja, 3 s wachten (10×300 ms), anders herstel (pagina 5)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="100" as="geometry"/></mxCell><mxCell id="p3_c" value="Standen: NAVIGATIE volgt de stand die de route nodig heeft (BUG #182). Alarmstand uit eerder herstel geldt alleen voor verkenningsritten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="230" height="100" as="geometry"/></mxCell><mxCell id="p3_d" value="Voor ELKE wissel die omgezet moet worden: is hij een kruismotor? Ja: niet omzetten als loc op kruiswissel staat" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="250" height="100" as="geometry"/></mxCell><mxCell id="p3_e" value="Ligt de wissel bij een bezette melder waar de loc net aankwam EN ACHTER de loc? (BUG #183) → eerst doorrijden tot alleen die melder bezet is en loc ver genoeg voorbij de tong (min. 2 s na het zien van de melder)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="280" height="130" as="geometry"/></mxCell><mxCell id="p3_e2" value="Wissel VOOR de loc (verderop in de sectie): geen creep nodig, direct omzetten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3_f" value="Wissel omzetten, terugmelding van Dinamo afwachten (tellers: wisselcommando N sinds verbinden)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3_g" value="Rijcommando naar blokken (bekend blok of alle blokken), snelheid verkenning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3_h" value="Volg melders: nieuwe melder bezet = overgang A→B; stop met stop-herhaling als er nog melders wijzigen ('Na de volledige stop veranderden er nog melders - stop wordt herhaald')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="230" height="90" as="geometry"/></mxCell><mxCell id="p3_i" value="Einde van de rit: DoelBereikt / Nieuwe melder / Doodlopend (geen nieuwe melder binnen wachttijd) / Kortsluiting / Onverwachte melder" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="250" height="120" as="geometry"/></mxCell><mxCell id="p3_j" value="Kortsluiting of onverwachte melder → pagina 5" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="1230" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3_k" value="Registreer overgang, rijrichting (RijrichtingVooruit, BUG #49) en wisselstand als bewijs. Overschrijving? Register meldt BUG #181" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="230" height="90" as="geometry"/></mxCell><mxCell id="p3_z" value="Verder met kies volgende opdracht" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="230" height="50" as="geometry"/></mxCell><mxCell id="p3_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_s" target="p3_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl2" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_a" target="p3_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl3" value="vrij" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_b" target="p3_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_c" target="p3_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl5" value="gewone wissel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_d" target="p3_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl6" value="nee, of al vrij" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_e" target="p3_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl7" value="voor de loc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_e" target="p3_e2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_e2" target="p3_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_f" target="p3_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_g" target="p3_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_h" target="p3_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl12" value="normaal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_i" target="p3_k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl13" value="kortsluiting/afwijking" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_i" target="p3_j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_pijl14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p3_k" target="p3_z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 Kortsluiting en herstel (BUG 169, 117, 134)"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_s" value="START: Dinamo meldt kortsluiting in blok X terwijl loc stilstaat of tijdens rit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p4_a" value="Noodstop. Stopcommando's gezonden? Anders stop herhalen (max 4 pogingen), 'kortsluitmelding tijdens stop' loggen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="90" as="geometry"/></mxCell><mxCell id="p4_b" value="Staat de loc op de kruiswissel (melder 24)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="100" as="geometry"/></mxCell><mxCell id="p4_c" value="Ja: GEEN losse wissels proberen. Navigatiefout: motor 10 of 13 staat verkeerd; stand eerst uit kennis (Engelse wissel 10/13), anders gebruiker vragen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="230" height="110" as="geometry"/></mxCell><mxCell id="p4_d" value="Per wissel bij de loc bepalen: wordt de wissel van de SAMENGEVOEGDE kant (punt) bereden of vanaf een GESPLITSTE TAK richting samenvoeging?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="250" height="120" as="geometry"/></mxCell><mxCell id="p4_e" value="Samengevoegde kant: omzetten helpt NIET → niet proberen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="p4_f" value="Tak richting samenvoeging: omzetten kan helpen → EERST deze wissels omzetten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p4_g" value="Wissels bij een bezette melder alleen met toestemming of als laatste redmiddel (ligt bij de loc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="80" as="geometry"/></mxCell><mxCell id="p4_h" value="Kortsluiting weg en loc rijdt vrij? (VrijheidsProef) Ligt de wissel niet in de kaart bij deze melder → toeval/timing, NIET vastleggen, terugzetten" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="250" height="120" as="geometry"/></mxCell><mxCell id="p4_i" value="VONDST: oplossing vastleggen (RegistreerAlarmOplossing), _alarmStand alleen voor de eerstvolgende VERKENNINGSstap; navigatie volgt eigen route (BUG #182)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="230" height="100" as="geometry"/></mxCell><mxCell id="p4_j" value="Niets hielp: 'Geen enkele wissel haalde de kortsluiting weg' → loc terugzetten door gebruiker; verkenning gestopt, voortgang bewaard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="1080" width="230" height="100" as="geometry"/></mxCell><mxCell id="p4_z" value="Verder: rit hervatten of opdracht opnieuw (Pogingen+1)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="230" height="50" as="geometry"/></mxCell><mxCell id="p4_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_s" target="p4_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_a" target="p4_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl3" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_b" target="p4_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl4" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_b" target="p4_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl5" value="punt" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_d" target="p4_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl6" value="tak" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_d" target="p4_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_f" target="p4_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_g" target="p4_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl9" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_h" target="p4_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl10" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_h" target="p4_j"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4_pijl11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p4_i" target="p4_z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6 Wisseltest en kruiswissel"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_s" value="START wisseltest: alle secties ontdekt" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="50" as="geometry"/></mxCell><mxCell id="p5_a" value="Kies wissel W en laatst bekende sectie L. Terug naar startsectie (route over bekende melders)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="80" as="geometry"/></mxCell><mxCell id="p5_b" value="Alle andere wissels in bekende basisstand, W omzetten (veilig: loc niet op W, pagina 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="80" as="geometry"/></mxCell><mxCell id="p5_c" value="Rij naar L" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="p5_d" value="Staat de loc weer in L?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="250" height="100" as="geometry"/></mxCell><mxCell id="p5_e" value="Ja: W-stand verandert dit pad niet. Leg vast: overgang bij deze stand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="230" height="70" as="geometry"/></mxCell><mxCell id="p5_f" value="Nee: andere stand nodig. Terug naar startsectie, W zo zetten dat het pad naar L loopt, doorrijden. Stand vastleggen (nooit mirroren/overschrijven)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="100" as="geometry"/></mxCell><mxCell id="p5_g" value="Kruiswissel-detectie: melder met ≥4 buren, OF twee vervolgmelders afhankelijk van een kruismotor (motorbewijs, KruisUitMotorBewijs)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="250" height="120" as="geometry"/></mxCell><mxCell id="p5_h" value="Kruis herkend: LeerKruisMidden (Leg 'kruismelder'). Kruisproeven: motor 13/10 combinaties (Engelse wissel), standen eerst uit instelling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="930" width="230" height="110" as="geometry"/></mxCell><mxCell id="p5_i" value="Nog wissels te testen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="250" height="100" as="geometry"/></mxCell><mxCell id="p5_z" value="EINDE wisseltest" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="230" height="50" as="geometry"/></mxCell><mxCell id="p5_pijl1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_s" target="p5_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_a" target="p5_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_b" target="p5_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_c" target="p5_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl5" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_d" target="p5_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl6" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_d" target="p5_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_e" target="p5_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_f" target="p5_g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl9" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_g" target="p5_h"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl10" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_g" target="p5_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_h" target="p5_i"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl12" value="ja" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p5_i" target="p5_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_pijl13" value="nee" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="p5_i" target="p5_z"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7 Vaste regels (checklist)"><mxGraphModel pageWidth="1600" pageHeight="2400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_r0" value="Altijd Nederlands, consistent" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r1" value="Elke bug genummerd in BUGS.md, geen bug twee keer oplossen" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r2" value="Bedrading van de baan wordt niet gecontroleerd" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="30" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r3" value="Wat niet op de baan getest is: altijd 'nog niet getest op de baan'" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r4" value="Nieuw blok = ook seinen en dienst bijwerken" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r5" value="Wissel-/kruiswisselstanden en rijrichtingen van Marco nooit overschrijven of spiegelen; twijfel = vragen" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r6" value="Wissel van samengevoegde kant: omzetten lost kortsluiting NIET op; vanaf tak richting samenvoeging wel (BUG #169)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r7" value="Wissel nooit omzetten terwijl de loc erop of er net voorbij is: doorrijden tot 1 melder bezet, ≥2 s na de melder (BUG #181/#183)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r8" value="Navigatie volgt routestand, alarmstand alleen voor verkenning (BUG #182)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r9" value="Rijrichting per overgang in BlokRelatie.RijrichtingVooruit (BUG #49)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="230" height="70" as="geometry"/></mxCell><mxCell id="p6_r10" value="Kennisregister: elke overschrijving wordt gelogd en geteld; doel 0" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="480" width="230" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>