<Window x:Class="Modeltreinbesturing.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modeltreinbesturing" Height="150" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelTekst" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InvoerBox" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" Padding="10,4" Margin="0,0,8,0" Click="Annuleren_Click"/>
            <Button Content="OK" Padding="10,4" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
