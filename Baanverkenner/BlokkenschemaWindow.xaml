<Window x:Class="Baanverkenner.BlokkenschemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blokkenschema (voorstel uit de baankaart)" Width="1100" Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="UitlegTekst" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="620"
                       Text="Blokken in de volgorde waarin de testloc ze bereed. Pijl = in die richting gereden. Oranje = melder met twee mogelijke vervolgen (kruiswissel). Stippellijn = Dinamo-blok onbekend."/>
            <Button Content="Opslaan als afbeelding (PNG)…" Click="OpslaanPng_Click" Margin="0,0,6,0" Padding="8,2"/>
            <Button Content="Opslaan als SVG…" Click="OpslaanSvg_Click" Margin="0,0,6,0" Padding="8,2"/>
            <Button Content="Ververs" Click="Ververs_Click" Margin="0,0,6,0" Padding="8,2"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
            <Canvas x:Name="Tekenvlak" Background="White"/>
        </ScrollViewer>
    </Grid>
</Window>
